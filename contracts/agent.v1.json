{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch.agent.v1",
  "title": "Dispatch agent adapter contract",
  "type": "object",
  "properties": {
    "turn": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string"
        },
        "mailContext": {
          "type": "object",
          "required": [
            "messageId",
            "threadId",
            "subject",
            "sender"
          ],
          "properties": {
            "messageId": {
              "type": "string"
            },
            "threadId": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "sender": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "accountReconnect": {
      "type": "object",
      "required": [
        "authUrl"
      ],
      "properties": {
        "authUrl": {
          "type": "string",
          "format": "uri"
        },
        "loginId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "executionPreferences": {
      "type": "object",
      "required": [
        "version",
        "mode"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "full-access",
            "workspace"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
