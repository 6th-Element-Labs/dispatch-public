{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch.work.v1",
  "title": "Dispatch work extraction output",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "existingId": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "task",
              "decision",
              "update"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "open",
              "waiting",
              "done"
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          },
          "certainty": {
            "enum": [
              "explicit",
              "suggested"
            ]
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "existingId",
          "kind",
          "title",
          "summary",
          "topic",
          "owner",
          "status",
          "due",
          "certainty",
          "contacts",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
